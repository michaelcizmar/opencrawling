[
  {
    "name": "${connectorName}",
    "description": "Custom Repository Connector generated by OpenCrawling Archetype",
    "type": "repository",
    "className": "${package}.${connectorName}",
    "maxConnections": 10,
    "configuration": {
      "basePath": "/data",
      "rateLimit": "100"
    }
  },
  {
    "name": "FileSystem_Local",
    "description": "Local File System",
    "type": "repository",
    "className": "org.opencrawling.crawler.connectors.filesystem.FileConnector",
    "maxConnections": 10,
    "configuration": {}
  },
  {
    "name": "PGVector_Output",
    "description": "PGVector Store",
    "type": "output",
    "className": "org.opencrawling.vector.VectorOutputConnector",
    "maxConnections": 10,
    "configuration": {
      "pgVectorUrl": "jdbc:postgresql://postgres-vector:5432/opencrawling",
      "pgVectorUsername": "opencrawling",
      "pgVectorPassword": "opencrawling_password",
      "pgVectorTableName": "vector_store",
      "pgVectorDimensions": "1024"
    }
  },
  {
    "name": "Ollama_Embedding_Default",
    "description": "Local Ollama Embeddings using mxbai-embed-large",
    "type": "transformation",
    "className": "org.opencrawling.embedding.OllamaEmbeddingConnector",
    "maxConnections": 10,
    "configuration": {
      "engine": "ollama",
      "model": "mxbai-embed-large"
    }
  }
]
